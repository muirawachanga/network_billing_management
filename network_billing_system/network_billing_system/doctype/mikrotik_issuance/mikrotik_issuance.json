{
 "doctype": "DocType",
 "name": "MikroTik Issuance",
 "module": "Network Billing System",
 "engine": "InnoDB",
 "autoname": "hash",
 "field_order": ["checkout", "router", "state", "duration_seconds", "username", "password", "fingerprint", "issuance_key", "predecessor", "incident", "attempts", "next_attempt_at", "last_failure"],
 "fields": [
  {"fieldname": "checkout", "fieldtype": "Link", "options": "Portal Checkout", "label": "Checkout", "reqd": 1, "search_index": 1, "in_list_view": 1},
  {"fieldname": "router", "fieldtype": "Link", "options": "MikroTik Router", "label": "Purchased Router Configuration", "reqd": 1, "search_index": 1},
  {"fieldname": "state", "fieldtype": "Select", "options": "Pending\nReady\nExpired\nReplacing\nReplaced", "label": "Access State", "reqd": 1, "search_index": 1, "in_list_view": 1},
  {"fieldname": "duration_seconds", "fieldtype": "Int", "label": "Connected-Time Limit (Seconds)", "reqd": 1},
  {"fieldname": "username", "fieldtype": "Data", "label": "RouterOS User Identifier", "reqd": 1, "unique": 1},
  {"fieldname": "password", "fieldtype": "Password", "label": "RouterOS Login Secret", "reqd": 1, "hidden": 1, "permlevel": 1, "no_copy": 1},
  {"fieldname": "fingerprint", "fieldtype": "Data", "label": "Credential Fingerprint", "reqd": 1, "unique": 1, "hidden": 1},
  {"fieldname": "issuance_key", "fieldtype": "Data", "label": "Issuance Key", "reqd": 1, "unique": 1, "hidden": 1},
  {"fieldname": "predecessor", "fieldtype": "Link", "options": "MikroTik Issuance", "label": "Replaces", "unique": 1},
  {"fieldname": "incident", "fieldtype": "Data", "label": "Replacement Incident"},
  {"fieldname": "attempts", "fieldtype": "Int", "label": "Provisioning Attempts"},
  {"fieldname": "next_attempt_at", "fieldtype": "Datetime", "label": "Next Provisioning Attempt", "search_index": 1},
  {"fieldname": "last_failure", "fieldtype": "Small Text", "label": "Last Provisioning Failure"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "report": 1},
  {"role": "Network Administrator", "read": 1, "report": 1}
 ]
}
