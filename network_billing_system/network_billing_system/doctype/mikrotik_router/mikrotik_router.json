{
 "doctype": "DocType",
 "name": "MikroTik Router",
 "module": "Network Billing System",
 "engine": "InnoDB",
 "autoname": "hash",
 "title_field": "label",
 "field_order": ["label", "zone", "router_identity", "hotspot_server", "host", "port", "transport", "allow_plaintext", "api_user", "api_password", "pilot_verified", "automatic_compensation"],
 "fields": [
  {"fieldname": "label", "fieldtype": "Data", "label": "Configuration Revision", "reqd": 1, "in_list_view": 1},
  {"fieldname": "zone", "fieldtype": "Link", "options": "Captive Portal Zone", "label": "Zone", "reqd": 1, "in_list_view": 1},
  {"fieldname": "router_identity", "fieldtype": "Data", "label": "Expected RouterOS System Identity", "reqd": 1},
  {"fieldname": "hotspot_server", "fieldtype": "Data", "label": "HotSpot Server", "reqd": 1},
  {"fieldname": "host", "fieldtype": "Data", "label": "Router API Host", "reqd": 1},
  {"fieldname": "port", "fieldtype": "Int", "label": "Router API Port", "default": "8729", "reqd": 1},
  {"fieldname": "transport", "fieldtype": "Select", "label": "Router API Transport", "options": "TLS\nPlaintext", "default": "TLS", "reqd": 1},
  {"fieldname": "allow_plaintext", "fieldtype": "Check", "label": "Allow Unencrypted RouterOS API", "description": "Prefer an encrypted tunnel for API access without certificates."},
  {"fieldname": "api_user", "fieldtype": "Data", "label": "Dedicated API User", "reqd": 1},
  {"fieldname": "api_password", "fieldtype": "Password", "label": "API Password", "reqd": 1},
  {"fieldname": "pilot_verified", "fieldtype": "Check", "label": "Hardware and API Pilot Verified", "default": "0"},
  {"fieldname": "automatic_compensation", "fieldtype": "Check", "label": "Allow Automatic Compensation When Accounting Is Proven", "default": "0"}
 ],
 "permissions": [
  {"role": "System Manager", "create": 1, "read": 1, "write": 1},
  {"role": "Network Administrator", "read": 1}
 ]
}
