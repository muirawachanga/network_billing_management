{
 "doctype": "DocType",
 "name": "Transfer Recipient",
 "module": "Network Billing System",
 "autoname": "hash",
 "title_field": "recipient_name",
 "track_changes": 1,
 "engine": "InnoDB",
 "field_order": ["recipient_name", "enabled", "email", "phone_number", "notes"],
 "fields": [
  {"fieldname": "recipient_name", "fieldtype": "Data", "label": "Recipient Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Enabled", "default": "0"},
  {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
  {"fieldname": "phone_number", "fieldtype": "Data", "label": "Contact Mobile Number"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Identity Notes", "description": "Reusable identity; zone and payout details belong to recipient accounts."}
 ],
 "permissions": [
  {"role": "System Manager", "create": 1, "read": 1, "write": 1},
  {"role": "Transfer Preparer", "create": 1, "read": 1, "write": 1},
  {"role": "Transfer Approver", "read": 1},
  {"role": "Transfer Operator", "read": 1},
  {"role": "Transfer Reconciler", "read": 1}
 ]
}
