{
 "doctype": "DocType",
 "name": "Transfer Recipient Account",
 "module": "Network Billing System",
 "autoname": "hash",
 "title_field": "account_label",
 "track_changes": 1,
 "engine": "InnoDB",
 "field_order": ["account_label", "recipient", "provider_account", "zone", "currency", "destination_type", "readiness", "first_name", "last_name", "phone_number", "network", "account_name", "account_number", "bank_branch_ref", "settlement_method", "till_name", "till_number", "paybill_name", "paybill_number", "paybill_account_number", "registration_state", "registration_resource_id", "payout_reference", "verification_confirmed", "verification_evidence", "verification_note", "verified_by", "verified_on"],
 "fields": [
  {"fieldname": "account_label", "fieldtype": "Data", "label": "Account Label", "reqd": 1, "in_list_view": 1},
  {"fieldname": "recipient", "fieldtype": "Link", "options": "Transfer Recipient", "label": "Recipient Identity", "reqd": 1, "in_list_view": 1},
  {"fieldname": "provider_account", "fieldtype": "Link", "options": "Transfer Provider Account", "label": "Provider Account", "reqd": 1, "in_list_view": 1},
  {"fieldname": "zone", "fieldtype": "Link", "options": "Captive Portal Zone", "label": "Allowed Zone", "reqd": 1, "in_list_view": 1, "description": "Exactly one zone per account. Create another account for another zone."},
  {"fieldname": "currency", "fieldtype": "Select", "options": "KES", "label": "Currency", "default": "KES", "reqd": 1},
  {"fieldname": "destination_type", "fieldtype": "Select", "options": "mobile_wallet\nbank_account\ntill\npaybill\nmerchant_wallet\nmerchant_bank_account", "label": "Destination Type", "reqd": 1},
  {"fieldname": "readiness", "fieldtype": "Select", "options": "Draft\nVerified\nDisabled", "default": "Draft", "label": "Readiness", "reqd": 1, "in_list_view": 1},
  {"fieldname": "first_name", "fieldtype": "Data", "label": "First Name", "depends_on": "eval:['mobile_wallet','merchant_wallet'].includes(doc.destination_type)"},
  {"fieldname": "last_name", "fieldtype": "Data", "label": "Last Name", "depends_on": "eval:['mobile_wallet','merchant_wallet'].includes(doc.destination_type)"},
  {"fieldname": "phone_number", "fieldtype": "Data", "label": "Mobile Number", "depends_on": "eval:['mobile_wallet','merchant_wallet'].includes(doc.destination_type)"},
  {"fieldname": "network", "fieldtype": "Select", "options": "Safaricom", "label": "Network", "default": "Safaricom", "depends_on": "eval:['mobile_wallet','merchant_wallet'].includes(doc.destination_type)"},
  {"fieldname": "account_name", "fieldtype": "Data", "label": "Bank Account Name", "depends_on": "eval:['bank_account','merchant_bank_account'].includes(doc.destination_type)"},
  {"fieldname": "account_number", "fieldtype": "Data", "label": "Bank Account Number", "depends_on": "eval:['bank_account','merchant_bank_account'].includes(doc.destination_type)"},
  {"fieldname": "bank_branch_ref", "fieldtype": "Data", "label": "Provider Bank Branch Reference", "depends_on": "eval:['bank_account','merchant_bank_account'].includes(doc.destination_type)"},
  {"fieldname": "settlement_method", "fieldtype": "Select", "options": "\nRTS\nEFT", "label": "Bank Settlement Method", "description": "External bank accounts: RTS only. Merchant bank accounts: RTS or EFT.", "depends_on": "eval:['bank_account','merchant_bank_account'].includes(doc.destination_type)"},
  {"fieldname": "till_name", "fieldtype": "Data", "label": "Till Name", "depends_on": "eval:doc.destination_type=='till'"},
  {"fieldname": "till_number", "fieldtype": "Data", "label": "Till Number", "depends_on": "eval:doc.destination_type=='till'"},
  {"fieldname": "paybill_name", "fieldtype": "Data", "label": "Paybill Name", "depends_on": "eval:doc.destination_type=='paybill'"},
  {"fieldname": "paybill_number", "fieldtype": "Data", "label": "Paybill Number", "depends_on": "eval:doc.destination_type=='paybill'"},
  {"fieldname": "paybill_account_number", "fieldtype": "Data", "label": "Paybill Account Number", "depends_on": "eval:doc.destination_type=='paybill'"},
  {"fieldname": "registration_state", "fieldtype": "Select", "options": "Draft\nRegistering\nCreated\nUnknown", "default": "Draft", "label": "Registration State", "read_only": 1, "reqd": 1},
  {"fieldname": "registration_resource_id", "fieldtype": "Data", "label": "Registration Resource ID", "read_only": 1, "description": "Optional registration resource identifier. Never automatically used as the payout reference."},
  {"fieldname": "payout_reference", "fieldtype": "Data", "label": "Confirmed Payout Reference", "description": "Enter the payout reference confirmed in the provider app; do not copy a registration URL."},
  {"fieldname": "verification_confirmed", "fieldtype": "Check", "label": "I Confirm the Payout Reference and All Destination Details in the Provider App", "default": "0"},
  {"fieldname": "verification_evidence", "fieldtype": "Small Text", "label": "Verification Evidence", "description": "Provider-app evidence or controlled evidence reference. Required for verification."},
  {"fieldname": "verification_note", "fieldtype": "Small Text", "label": "Verification Note", "description": "Verified destination and evidence fields are immutable. Disable and create a replacement to change them."},
  {"fieldname": "verified_by", "fieldtype": "Link", "options": "User", "label": "Verified By", "read_only": 1},
  {"fieldname": "verified_on", "fieldtype": "Datetime", "label": "Verified On", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "create": 1, "read": 1, "write": 1},
  {"role": "Transfer Preparer", "create": 1, "read": 1, "write": 1},
  {"role": "Transfer Approver", "create": 1, "read": 1, "write": 1},
  {"role": "Transfer Operator", "read": 1},
  {"role": "Transfer Reconciler", "read": 1}
 ]
}
